# Runtime database required by the A-05 publish API.
DATABASE_URL=

# Bearer token signing secret (>= 32 bytes).
TOKEN_SECRET=

# HTTP listen port (default 3000).
PORT=

# Google OAuth (optional; when all three are set, Google sign-in is enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Profile data encryption key and supplier NDA version.
PROFILE_DATA_KEY=
SUPPLIER_NDA_VERSION=

# Development/demo draft only until legal review is complete.
PROJECT_DISCLOSURE_CONSENT_VERSION=

# Dedicated local PostgreSQL test database (local-only; never point at production).
TEST_DATABASE_URL=
