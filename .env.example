# 로컬 개발용 환경 변수 이름 예시 (값은 커밋하지 않는다)
DATABASE_URL=postgresql://localhost:5432/majayong
PORT=3000
NODE_ENV=development

# 인증 (A 담당 계약)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 외부 연동 (C 담당)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
TOSS_SANDBOX_BASE_URL=https://api.tosspayments.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI (A 담당)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_USD_TO_KRW_RATE=

# A 인증 (세션 토큰 서명, 32바이트 이상)
TOKEN_SECRET=
GOOGLE_REDIRECT_URI=

# A 프로필
PROFILE_DATA_KEY=
SUPPLIER_NDA_VERSION=
PROJECT_DISCLOSURE_CONSENT_VERSION=
ALLOW_LOCAL_AUTH=

# C (Toss webhook / Supabase storage)

SUPABASE_STORAGE_BUCKET=
