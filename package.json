{
  "name": "majayong",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --runInBand",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "2.118.0",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2"
  }
}
