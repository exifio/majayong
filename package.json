{
  "name": "majayong",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc && NODE_ENV=development node dist/index.js",
    "snapshot": "node dist/snapshot.js",
    "check:links": "node dist/check-links.js",
    "test": "npm run test:node && npm run test:a",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:verify:b": "node scripts/verify-b-pg.mjs",
    "test:a": "jest --runInBand",
    "test:node": "DATABASE_URL=\"${DATABASE_URL:-}\" node --import ./src/test-support/resolve-ts.mjs --test 'src/**/*.spec.ts' 'tests/b/*.test.ts' 'tests/c/*.test.ts'",
    "test:b": "npm run test:node",
    "test:c": "npm run test:node",
    "test:integration": "DATABASE_URL=\"${DATABASE_URL:-}\" node --import ./src/test-support/resolve-ts.mjs --test 'tests/integration/*.test.ts'",
    "test:coverage": "node scripts/coverage.mjs",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "check:rules": "node scripts/check-rules.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0"
  }
}
